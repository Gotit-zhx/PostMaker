# 公开工作台部署配置。复制为 .env 后再启动：
# cp .env.public.example .env

# PostMaker 与 DataRadar 必须使用同一个强随机密钥。
# 生成示例：openssl rand -hex 32
WORKSPACE_AUTH_SECRET=replace-with-a-long-random-secret

# 工作台对外端口。
POSTMAKER_PORT=8787

# HTTPS 反向代理后改为 true；本地 HTTP 保持 false。
POSTMAKER_COOKIE_SECURE=false

# 可选：仅在需要 AI 生成或摘要时填写。不要把真实密钥提交到仓库。
AI_API_KEY=
AI_API_BASE=
AI_MODEL=

# RSSHub 使用的镜像。生产环境建议固定版本或 digest，不要长期使用 latest。
RSSHUB_IMAGE=diygod/rsshub:latest
RSSHUB_CACHE_EXPIRE=900
# 工作台给 RSSHub 推荐来源生成的内部地址。单机 Compose 保持默认即可。
RSSHUB_SOURCE_BASE_URL=http://rsshub:1200

# 可选：DataRadar CORS 来源。通常由 PostMaker 代理请求，不需要修改。
# ALLOWED_ORIGINS=http://localhost:8787
