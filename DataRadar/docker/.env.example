# ============================================
# DataRadar Docker 环境变量
# 复制此文件为 .env 并填写配置:  cp .env.example .env
# ============================================

# ============================================
# AI 配置（必填）
# ============================================

# AI API Key（LiteLLM 格式）
AI_API_KEY=your-api-key-here
# 模型名称（如 openai/gpt-4o, deepseek/deepseek-chat）
AI_MODEL=openai/gpt-4o
# 自定义 API 端点（可选，使用 OpenAI 官方可留空）
AI_API_BASE=

# ============================================
# PostgreSQL 配置
# ============================================

# 数据库密码（默认 dataradar_secret）
POSTGRES_PASSWORD=dataradar_secret

# ============================================
# 远程存储配置（S3 兼容协议，可选）
# 支持 AWS S3 / Cloudflare R2 / 阿里云 OSS / 腾讯云 COS
# ============================================

S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ============================================
# 服务端口
# ============================================

# Nginx 代理端口（默认 8000）
NGINX_PORT=8000
